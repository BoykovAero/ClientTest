# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather (шаг 2.1 в DEPLOY.md)
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram user id от @userinfobot. Бот отвечает только на него.
ALLOWED_USER_ID=

# ─── OpenAI (Whisper + GPT) ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Модель для разбора ответа в список дел
OPENAI_MODEL=gpt-4o-mini
# Модель распознавания речи
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── iCloud Calendar (CalDAV) ────────────────────────────────────────────────
# Apple ID (почта) и App-Specific Password с appleid.apple.com.
# ВАЖНО: это НЕ основной пароль от Apple ID. Формат: xxxx-xxxx-xxxx-xxxx
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
ICLOUD_CALDAV_URL=https://caldav.icloud.com
# Имя календаря в приложении «Календарь» на Mac. Пусто = календарь по умолчанию.
ICLOUD_CALENDAR_NAME=

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Пути к файлам OAuth (см. шаг 2.4). В git они НЕ попадают.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# primary = основной календарь аккаунта
GOOGLE_CALENDAR_ID=primary

# ─── Расписание ──────────────────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
DAILY_PROMPT_TIME=08:45
# Длительность события по умолчанию, если время окончания не названо (минуты)
DEFAULT_EVENT_MINUTES=60

# ─── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
