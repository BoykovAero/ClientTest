# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather (шаг 2.1 в DEPLOY.md)
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram user id от @userinfobot. Бот отвечает только на него.
ALLOWED_USER_ID=

# ─── OpenAI (Whisper + GPT) ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Модель для разбора ответа в список дел
OPENAI_MODEL=gpt-4o-mini
# Модель распознавания речи
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── iCloud Calendar (CalDAV) ────────────────────────────────────────────────
# Apple ID (почта) и App-Specific Password с appleid.apple.com.
# ВАЖНО: это НЕ основной пароль от Apple ID. Формат: xxxx-xxxx-xxxx-xxxx
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
ICLOUD_CALDAV_URL=https://caldav.icloud.com
# Имя календаря в приложении «Календарь» на Mac. Пусто = календарь по умолчанию.
ICLOUD_CALENDAR_NAME=

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Два способа на выбор, нужен ровно один. В git эти файлы НЕ попадают.
#
# СПОСОБ 1 (рекомендуется): ключ сервисного аккаунта.
# Браузер не нужен, срок действия не истекает. Календарь нужно расшарить
# на адрес сервисного аккаунта с правом «Вносить изменения в мероприятия».
#
# 1а. На облачном хостинге — весь JSON-ключ в переменной. Файлов на диске
#     при этом не нужно вообще. Принимается и сам JSON, и base64 от него
#     (на случай панелей, которые ломают многострочные значения).
#     Имеет приоритет над 1б.
GOOGLE_SERVICE_ACCOUNT_JSON=
# 1б. На своём сервере — путь к файлу с тем же JSON-ключом.
GOOGLE_SERVICE_ACCOUNT_FILE=
#
# СПОСОБ 2: OAuth-токен от google_auth_setup.py (нужен браузер).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
#
# Куда писать события. При сервисном аккаунте ОБЯЗАТЕЛЬНО укажи адрес своего
# календаря (обычно gmail): "primary" у сервисного аккаунта — его собственный
# пустой календарь, и события уйдут туда.
GOOGLE_CALENDAR_ID=primary

# ─── Расписание ──────────────────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
DAILY_PROMPT_TIME=08:45
# Длительность события по умолчанию, если время окончания не названо (минуты)
DEFAULT_EVENT_MINUTES=60

# ─── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
